<view class="page">
  <view class="brand-row"><view class="brand"><view class="brand-mark"><view/><view/><view/><view/></view><text>豆屿</text><text class="brand-en">DOUYU</text></view><view class="local-badge"><view class="status-dot"/>图片本地处理</view></view>
  <view hidden="{{tab === 'library'}}">
    <view class="hero" wx:if="{{tab === 'make'}}"><view class="eyebrow">MAKE SOMETHING LITTLE</view><view class="hero-title">把喜欢，<text>一颗颗拼起来。</text></view><view class="hero-sub">一张图片，一份专属你的拼豆图纸。</view></view>
    <view class="editor-heading" wx:else><view><view class="eyebrow">YOUR LITTLE MASTERPIECE</view><view class="section-title">{{title}}</view></view><button class="text-button" bindtap="rename">重命名</button></view>
    <view class="workspace">
      <view class="canvas-head"><view class="segmented"><button class="{{viewMode === 'beads' ? 'active' : ''}}" data-mode="beads" bindtap="changeView">拼豆效果</button><button class="{{viewMode === 'grid' ? 'active' : ''}}" data-mode="grid" bindtap="changeView">色号图纸</button><button wx:if="{{hasSource}}" class="{{viewMode === 'original' ? 'active' : ''}}" data-mode="original" bindtap="changeView">原图</button></view><text class="canvas-size">{{gridWidth}} × {{gridHeight}}</text></view>
      <view class="board-wrap"><canvas type="2d" id="board" class="board" disable-scroll="true" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"/><view class="board-tag">{{viewMode === 'original' ? '裁剪预览' : 'MARD 色卡'}}<text wx:if="{{dirty}}"> · 未保存</text></view></view>
      <view class="canvas-foot"><text>{{viewMode === 'original' ? '调整下方构图后，重新生成图纸' : '双指缩放 · 移动工具拖动画布'}}</text><view class="zoom-tools"><button bindtap="zoomOut">−</button><button class="zoom-label" bindtap="resetView">{{zoomLabel}}%</button><button bindtap="zoomIn">＋</button></view></view>
    </view>
    <view class="metrics"><view><text class="metric-number">{{total}}</text><text class="metric-label">颗豆子</text></view><view><text class="metric-number">{{colorCount}}</text><text class="metric-label">种颜色</text></view><view><text class="metric-number">{{gridWidth}}<text class="metric-times"> × </text>{{gridHeight}}</text><text class="metric-label">图纸格数</text></view></view>
    <view wx:if="{{tab === 'make'}}">
      <view class="import-row"><button class="import-button" bindtap="chooseImage" disabled="{{busy}}"><text class="plus-icon">＋</text><view><text class="import-title">导入你的图片</text><text class="import-sub">从相册选择，或拍一张照片</text></view><text class="arrow">↗</text></button><button class="demo-button" bindtap="useDemo" disabled="{{busy}}">试试<text>示例</text></button></view>
      <view class="card settings-card"><view class="section-heading"><text class="section-title">制作设置</text><text class="small-note">{{settingsChanged ? '参数已改，等待生成' : '让图纸更适合你'}} </text></view>
        <view class="field-label"><text>横向豆数</text><text class="field-value">{{width}} 颗</text></view>
        <view class="chips"><button wx:for="{{widths}}" wx:key="*this" class="chip {{width === item ? 'selected' : ''}}" data-width="{{item}}" bindtap="selectWidth">{{item}}</button></view>
        <slider min="16" max="128" step="1" value="{{width}}" activeColor="#376b55" backgroundColor="#e7ebe4" block-color="#376b55" block-size="20" bindchange="slideWidth"/>
        <view class="two-fields"><view><text class="field-label">颜色上限</text><picker range="{{colorOptions}}" value="{{colorIndex}}" bindchange="selectColors"><view class="picker-value">{{colorOptions[colorIndex]}} 色以内<text>⌄</text></view></picker></view><view><text class="field-label">画面比例</text><picker range="{{ratioOptions}}" value="{{ratioIndex}}" bindchange="selectRatio"><view class="picker-value">{{ratioOptions[ratioIndex]}}<text>⌄</text></view></picker></view></view>
        <view class="palette-note"><view class="palette-dots"><view style="background:#e5b986"/><view style="background:#81a88d"/><view style="background:#a4c4ca"/><view style="background:#d89794"/></view><view><text>MARD 221 参考色卡</text><text class="muted">实物颜色请对照手头色卡</text></view></view>
        <button class="advanced-toggle" bindtap="toggleAdvanced">构图与细节调整 <text>{{advanced ? '−' : '＋'}}</text></button>
        <view wx:if="{{advanced}}" class="advanced">
          <view class="field-label"><text>画面填充</text><button class="text-button" bindtap="rotate">旋转 90°</button></view>
          <view class="chips"><button class="chip {{fit === 'contain' ? 'selected' : ''}}" data-fit="contain" bindtap="selectFit">完整显示</button><button class="chip {{fit === 'cover' ? 'selected' : ''}}" data-fit="cover" bindtap="selectFit">裁剪铺满</button></view>
          <view class="field-label"><text>裁剪放大</text><text>{{cropZoom}} 倍</text></view><slider min="1" max="3" step="0.1" value="{{cropZoom}}" activeColor="#376b55" block-size="18" data-field="cropZoom" bindchange="cropSlider"/>
          <view class="field-label">水平位置</view><slider min="-100" max="100" value="{{offsetX}}" activeColor="#376b55" block-size="18" data-field="offsetX" bindchange="cropSlider"/>
          <view class="field-label">垂直位置</view><slider min="-100" max="100" value="{{offsetY}}" activeColor="#376b55" block-size="18" data-field="offsetY" bindchange="cropSlider"/>
          <view class="setting-row"><view>像素画采样<text class="muted">像素素材开启，照片保持关闭</text></view><switch checked="{{sampling === 'nearest'}}" color="#376b55" bindchange="toggleSampling"/></view>
          <view class="setting-row"><view>保留透明背景<text class="muted">关闭后将透明区域铺为白色</text></view><switch checked="{{background === 'transparent'}}" color="#376b55" bindchange="toggleBackground"/></view>
          <view class="setting-row"><view>减少相近杂点<text class="muted">轻度合并，保留高对比细节</text></view><switch checked="{{denoise}}" color="#376b55" bindchange="toggleDenoise"/></view>
        </view>
      </view>
      <button class="primary generate" bindtap="generate" loading="{{busy}}" disabled="{{busy || !hasSource}}">{{busy ? '正在处理…' : '生成我的拼豆图纸'}} <text wx:if="{{!busy}}">↗</text></button><view class="privacy-caption">无需登录 · 图片留在你的设备上</view>
    </view>
    <view wx:if="{{tab === 'edit'}}">
      <view class="tool-card"><view class="tool-row"><button wx:for="{{tools}}" wx:key="id" class="tool {{tool === item.id ? 'selected' : ''}}" data-tool="{{item.id}}" bindtap="setTool"><text>{{item.icon}}</text>{{item.name}}</button><button class="tool" bindtap="undo" disabled="{{!canUndo}}"><text>↶</text>撤销</button><button class="tool" bindtap="redo" disabled="{{!canRedo}}"><text>↷</text>重做</button></view><view class="tool-hint">{{toolHint}}</view></view>
      <view class="card"><view class="section-heading"><text class="section-title">用豆清单</text><button class="text-button" bindtap="copyList">复制清单</button></view><view class="selected-color"><view class="color-preview" style="background:{{selectedHex}}"/><text>当前画笔：{{selectedColor}}</text><button class="text-button" bindtap="openPalette">全部色卡 ›</button></view><view class="swatch-grid"><button wx:for="{{stats}}" wx:key="code" class="swatch {{selectedColor === item.code ? 'swatch-selected' : ''}}" data-code="{{item.code}}" bindtap="selectColor"><view class="swatch-color" style="background:{{item.hex}}"/><text class="swatch-code">{{item.code}}</text><text class="swatch-count">{{item.count}} 颗</text></button></view><view wx:if="{{!stats.length}}" class="muted">画布是空的，选择色卡后用画笔开始创作。</view><view class="muted palette-disclaimer">空格不计入豆数。手动加色后，颜色数可能超过生成上限。</view></view>
      <view class="action-row"><button class="secondary" bindtap="save" disabled="{{busy}}">保存作品</button><button class="primary" bindtap="exportPattern" disabled="{{busy}}" loading="{{busy}}">导出图纸 ↗</button></view>
    </view>
  </view>
  <view wx:if="{{tab === 'library'}}" class="library"><view class="eyebrow">A LITTLE COLLECTION</view><view class="hero-title">我的<text>拼豆小岛。</text></view><view class="hero-sub">把每一次灵感，好好收藏在这里。</view><view wx:if="{{!projects.length}}" class="empty-card"><view class="empty-icon">▦</view><view class="section-title">第一份作品，从一张图片开始</view><text class="muted">生成图纸后，点击「保存作品」就能继续编辑。</text><button class="primary" data-tab="make" bindtap="switchTab">去制作一份 ↗</button></view><view wx:for="{{projects}}" wx:key="id" class="project-card"><view class="project-colors" data-id="{{item.id}}" bindtap="openProject"><view wx:for="{{item.colors}}" wx:for-item="hex" wx:key="*this" style="background:{{hex}}"/></view><view class="project-info" data-id="{{item.id}}" bindtap="openProject"><view class="project-title">{{item.title}}</view><view class="muted">{{item.width}} × {{item.height}} 格 · {{item.total}} 颗</view><view class="project-date">{{item.dateLabel}}</view></view><button class="delete-button" data-id="{{item.id}}" bindtap="deleteProject">删除</button></view><view class="privacy-caption">作品保存在当前设备。清理小程序数据会移除本地作品。</view></view>
  <view class="bottom-nav"><button class="{{tab === 'make' ? 'nav-active' : ''}}" data-tab="make" bindtap="switchTab"><text>✦</text>制作</button><button class="{{tab === 'edit' ? 'nav-active' : ''}}" data-tab="edit" bindtap="switchTab"><text>▦</text>图纸</button><button class="{{tab === 'library' ? 'nav-active' : ''}}" data-tab="library" bindtap="switchTab"><text>▤</text>我的作品</button></view>
  <view wx:if="{{paletteOpen}}" class="modal-mask" bindtap="closePalette"><view class="palette-modal" catchtap="noop"><view class="section-heading"><text class="section-title">选择画笔颜色</text><button class="text-button" bindtap="closePalette">完成</button></view><input class="search" placeholder="搜索色号，如 H7、B12" value="{{colorSearch}}" bindinput="searchColor"/><scroll-view scroll-y class="palette-scroll"><view class="swatch-grid"><button wx:for="{{paletteColors}}" wx:key="code" class="swatch {{selectedColor === item.code ? 'swatch-selected' : ''}}" data-code="{{item.code}}" bindtap="selectColor"><view class="swatch-color" style="background:{{item.hex}}"/><text class="swatch-code">{{item.code}}</text></button></view></scroll-view></view></view>
  <canvas type="2d" id="processCanvas" class="hidden-canvas"/>
  <canvas type="2d" id="exportCanvas" class="hidden-canvas"/>
</view>

.page { padding: 34rpx 32rpx 190rpx; max-width: 1000rpx; margin: auto; }
.brand-row,.brand,.local-badge,.section-heading,.canvas-head,.canvas-foot,.field-label,.setting-row,.selected-color { display:flex; align-items:center; justify-content:space-between; }
.brand-row { margin-bottom:42rpx; }.brand { gap:14rpx; font-size:37rpx; font-weight:700; }.brand-en { font-size:19rpx; font-weight:500; letter-spacing:3rpx; color:#8a978c; margin-left:4rpx; }
.brand-mark { width:36rpx; height:36rpx; display:grid; grid-template-columns:1fr 1fr; gap:4rpx; transform:rotate(-8deg); }.brand-mark view { background:#376b55; border-radius:4rpx; }.brand-mark view:last-child { background:#d6ad73; }
.local-badge { gap:9rpx; font-size:19rpx; color:#758675; }.status-dot { width:9rpx; height:9rpx; border-radius:50%; background:#7ba485; }
.eyebrow { color:#849181; letter-spacing:3rpx; font-size:18rpx; font-weight:600; margin-bottom:16rpx; }.hero-title { font-size:44rpx; font-weight:700; letter-spacing:-1.5rpx; line-height:1.4; }.hero-title text { color:#59765f; }.hero-sub { color:#8a9187; font-size:24rpx; margin-top:12rpx; margin-bottom:34rpx; }.editor-heading { display:flex; justify-content:space-between; align-items:center; margin:12rpx 0 26rpx; }
.workspace { background:#fff; border:1rpx solid #e2e6dc; border-radius:28rpx; overflow:hidden; box-shadow:0 10rpx 30rpx rgba(44,60,37,.035); }.canvas-head { padding:20rpx; gap:12rpx; }.segmented { display:flex; gap:3rpx; padding:5rpx; background:#f1f3ed; border-radius:14rpx; }.segmented button { padding:12rpx 16rpx; font-size:22rpx; color:#899284; border-radius:10rpx; }.segmented .active { color:#32553f; background:white; box-shadow:0 2rpx 5rpx rgba(40,60,40,.06); font-weight:600; }.canvas-size { font-size:20rpx; color:#8c978b; white-space:nowrap; }.board-wrap { position:relative; margin:0 12rpx; border-radius:18rpx; overflow:hidden; background:#eaece5; }.board { display:block; width:100%; height:320px; }.board-tag { position:absolute; top:16rpx; left:16rpx; background:rgba(255,255,255,.86); padding:8rpx 12rpx; font-size:17rpx; letter-spacing:1rpx; color:#74816f; border-radius:8rpx; pointer-events:none; }.canvas-foot { padding:15rpx 20rpx; color:#94a08f; font-size:18rpx; }.zoom-tools { display:flex; align-items:center; gap:12rpx; }.zoom-tools button { font-size:30rpx; width:38rpx; height:42rpx; }.zoom-tools .zoom-label { font-size:19rpx; width:64rpx; line-height:42rpx; }
.metrics { display:flex; margin:24rpx 0; background:#edeFE7; border-radius:20rpx; padding:24rpx 0; }.metrics>view { flex:1; display:flex; align-items:center; flex-direction:column; border-right:1rpx solid #dbe1d4; }.metrics>view:last-child { border:0; }.metric-number { font-size:34rpx; font-weight:600; font-variant-numeric:tabular-nums; }.metric-times { font-size:22rpx; color:#8a9880; }.metric-label { font-size:20rpx; color:#8b9782; margin-top:6rpx; }
.import-row { display:flex; gap:16rpx; margin:28rpx 0; }.import-button { flex:1; border:2rpx dashed #c9d3c1; border-radius:20rpx; display:flex; align-items:center; gap:20rpx; text-align:left; padding:24rpx 22rpx; background:#f1f4ec; }.plus-icon { font-size:45rpx; color:#577452; font-weight:300; }.import-button view { flex:1; }.import-title,.import-sub { display:block; }.import-title { font-size:26rpx; font-weight:600; }.import-sub { color:#8c9883; font-size:18rpx; margin-top:7rpx; }.arrow { color:#7f9674; font-size:32rpx; }.demo-button { background:#eee9df; border:1rpx solid #e7e1d4; border-radius:20rpx; padding:22rpx; font-size:23rpx; color:#9a8262; }.demo-button text { display:block; margin-top:5rpx; }
.card { padding:28rpx; border:1rpx solid #e4e7de; border-radius:24rpx; background:#fff; margin-bottom:24rpx; }.section-heading { margin-bottom:24rpx; gap:12rpx; }.section-title { font-size:29rpx; font-weight:650; }.small-note { font-size:19rpx; color:#929a8b; }.field-label { font-size:24rpx; margin-bottom:18rpx; margin-top:25rpx; }.field-value { color:#487052; font-weight:600; }.chips { display:flex; gap:12rpx; }.chip { flex:1; text-align:center; border-radius:12rpx; border:1rpx solid #e4e9df; background:#f8f9f5; padding:15rpx 5rpx; font-size:24rpx; color:#899280; }.chip.selected { color:#386047; background:#e9f0e3; border-color:#9eb392; font-weight:600; }slider { margin:22rpx 3rpx; }.two-fields { display:flex; gap:22rpx; }.two-fields>view { flex:1; }.picker-value { display:flex; justify-content:space-between; background:#f7f8f3; border:1rpx solid #e9ebe3; border-radius:12rpx; padding:20rpx; font-size:24rpx; }.picker-value text { color:#9aa48d; }.palette-note { display:flex; align-items:center; gap:18rpx; margin:28rpx 0; padding:22rpx 0 0; border-top:1rpx solid #edf0e8; font-size:22rpx; }.palette-dots { display:grid; grid-template-columns:20rpx 20rpx; gap:5rpx; }.palette-dots view { width:20rpx; height:20rpx; border-radius:5rpx; }.muted { display:block; color:#929b8b; font-size:21rpx; line-height:1.7; }.palette-note .muted { font-size:18rpx; margin-top:5rpx; }.advanced-toggle { display:flex; width:100%; justify-content:space-between; color:#708565; font-size:23rpx; padding-top:18rpx; border-top:1rpx solid #edf0e8; }.setting-row { gap:20rpx; padding:18rpx 0; font-size:24rpx; border-bottom:1rpx solid #f1f2ed; }.setting-row switch { transform:scale(.78); transform-origin:right center; }.setting-row .muted { font-size:19rpx; }.primary { background:#36674f!important; color:#fff!important; border-radius:16rpx; padding:25rpx; text-align:center; font-size:27rpx; font-weight:600; box-shadow:0 6rpx 15rpx rgba(40,80,50,.09); }.primary[disabled] { opacity:.5; }.generate { display:flex; justify-content:center; gap:25rpx; }.privacy-caption { margin:20rpx 0 30rpx; font-size:20rpx; text-align:center; color:#9aa18f; line-height:1.7; }
.tool-card { border-radius:20rpx; padding:22rpx 12rpx 14rpx; background:white; border:1rpx solid #e4e7de; margin:24rpx 0; }.tool-row { display:flex; gap:4rpx; }.tool { flex:1; display:flex; flex-direction:column; align-items:center; gap:8rpx; padding:12rpx 1rpx; font-size:20rpx; border-radius:12rpx; color:#86947b; }.tool text { font-size:32rpx; line-height:1; }.tool.selected { background:#eaf0e5; color:#345c43; }.tool-hint { font-size:20rpx; color:#8a9780; text-align:center; margin-top:16rpx; }.text-button { color:#52724c; font-size:23rpx; padding:8rpx 0; }.selected-color { justify-content:flex-start; gap:14rpx; font-size:23rpx; background:#f5f7f0; border-radius:12rpx; padding:16rpx; margin-bottom:24rpx; }.selected-color .text-button { margin-left:auto; font-size:21rpx; }.color-preview { width:30rpx; height:30rpx; border:1rpx solid #c4ccbd; border-radius:8rpx; }.swatch-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12rpx; }.swatch { padding:12rpx 6rpx; border:2rpx solid #eef0e9; border-radius:13rpx; text-align:center; display:flex; flex-direction:column; align-items:center; }.swatch-selected { border-color:#6d8e60; background:#f1f5eb; }.swatch-color { height:42rpx; width:100%; border-radius:7rpx; border:1rpx solid rgba(0,0,0,.05); }.swatch-code { font-size:22rpx; font-weight:600; margin-top:10rpx; }.swatch-count { font-size:19rpx; color:#919984; margin-top:4rpx; }.palette-disclaimer { font-size:19rpx; margin-top:22rpx; }.action-row { display:flex; gap:18rpx; margin-top:26rpx; }.action-row button { flex:1; }.secondary { color:#4b6947; border:1rpx solid #aab9a0; border-radius:16rpx; padding:25rpx; font-size:27rpx; background:#f8faf4; }
.bottom-nav { position:fixed; bottom:0; left:0; right:0; z-index:10; padding:17rpx 30rpx calc(17rpx + env(safe-area-inset-bottom)); display:flex; background:rgba(250,251,246,.98); border-top:1rpx solid #e4e8dd; }.bottom-nav button { flex:1; display:flex; align-items:center; flex-direction:column; gap:7rpx; font-size:20rpx; color:#a4ad98; }.bottom-nav button text { font-size:33rpx; line-height:1.2; }.bottom-nav .nav-active { color:#3a644b; font-weight:600; }
.empty-card { margin-top:40rpx; background:#fff; border:1rpx solid #e4e7de; border-radius:24rpx; padding:50rpx 30rpx; text-align:center; }.empty-icon { font-size:100rpx; color:#a4b896; margin-bottom:25rpx; }.empty-card .muted { margin:20rpx 0 35rpx; }.project-card { display:flex; align-items:center; padding:25rpx; gap:22rpx; background:#fff; border:1rpx solid #e4e7de; border-radius:22rpx; margin-bottom:20rpx; }.project-colors { width:94rpx; height:94rpx; display:grid; grid-template-columns:repeat(3,1fr); overflow:hidden; border-radius:14rpx; background:#ecf0e5; }.project-info { flex:1; }.project-title { font-weight:600; margin-bottom:8rpx; }.project-date { color:#a1aa95; font-size:18rpx; margin-top:5rpx; }.delete-button { color:#aa9182; font-size:21rpx; padding:15rpx; }
.modal-mask { position:fixed; inset:0; z-index:20; background:rgba(25,40,30,.3); display:flex; align-items:flex-end; }.palette-modal { width:100%; padding:32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; background:#fff; }.palette-scroll { height:55vh; }.search { background:#f1f4ec; border-radius:12rpx; padding:20rpx; height:80rpx; font-size:24rpx; margin-bottom:22rpx; }.hidden-canvas { position:fixed; left:-10000px; top:0; width:320px; height:320px; pointer-events:none; }
